  "paths": {
    "/auth/register/student": {
      "post": {
        "summary": "registerStudent",
        "description": "Register a new student account with email, password, first name, and last name.",
        "tags": ["Auth", "Student"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "firstName", "lastName"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Student's email address."
                  },
                  "password": {
                    "type": "string",
                    "description": "Password for the student account."
                  },
                  "firstName": {
                    "type": "string",
                    "description": "Student's first name."
                  },
                  "lastName": {
                    "type": "string",
                    "description": "Student's last name."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student registered successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "student": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing required fields.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
