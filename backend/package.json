{
  "name": "tutor-support-system-backend",
  "version": "1.0.0",
  "description": "Backend cho hệ thống hỗ trợ gia sư",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seedUsers.ts",
    "seed:comments": "tsx --env-file=.env src/utils/seedComments.ts",
    "seed:conversations": "tsx --env-file=.env src/utils/seedConversations.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "tutor",
    "education",
    "express",
    "mongodb",
    "sqlserver"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "sequelize": "^6.35.2",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "tedious": "^16.6.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
